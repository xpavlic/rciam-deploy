{% macro ams_config(agent) %}
    "ams": {
        {% if agent.name is defined %}
            "deployer_name": "{{ agent.name }}",
        {% endif %}
        "host": "{{ fedreg_agent_ams.host }}",
        "project": "{{ fedreg_agent_ams.project }}",
        "pull_topic": "{{ agent.pull_topic }}",
        "pull_sub": "{{ agent.pull_sub }}",
        "token": "{{ fedreg_agent_ams.token }}",
        "pub_topic": "{{ fedreg_agent_ams.pub_topic }}",
        "poll_interval": {{ fedreg_agent_ams.time_interval }}
    }
{% endmacro %}
{% macro rabbitmq_config(agent) %}
    "rabbitmq": {
        {% if agent.name is defined %}
            "deployer_name": "{{ agent.name }}",
        {% endif %}
        "host": "{{ fedreg_agent_rabbitmq.host }}",
        "vhost": "{{ fedreg_agent_rabbitmq.vhost }}",
        "pub_queue": "{{ fedreg_agent_rabbitmq.pub_queue }}",
        "sub_queue": "{{ fedreg_agent_rabbitmq.sub_queue }}",
        "username": "{{ fedreg_agent_rabbitmq.username }}",
        "password": "{{ fedreg_agent_rabbitmq.password }}"
    }
{% endmacro %}
{% macro attribute_mapping(mapping) %}
{
    "id": {{ mapping.id }},
    "type": "{{ mapping.type }}",
    "attribute": "{{ mapping.attribute }}"
    {% if mapping.unique is defined %},
        "unique": {{ mapping.unique | lower }}
    {% endif %}
    {% if mapping.value_mapping is defined %},
    "value_mapping": {
        {% for value_key, value in mapping.value_mapping.items() %}
            "{{ value_key }}": {{ value | lower }}{% if not loop.last %},{% endif %}
        {% endfor %}
    }
    {% endif %}
}
{% endmacro %}
{% macro perun_config(perun) %}
    "perun": {
        "api_url": "{{ perun.api_url }}",
        "username": "{{ perun.username }}",
        "password": "{{ perun.password }}",
        "ext_source_name": "{{ perun.ext_source_name }}",
        "sp_managers_vo_id": {{ perun.sp_managers_vo_id }},
        {% if perun.sp_managers_parent_group_id is defined %}
            "sp_managers_parent_group_id": {{ perun.sp_managers_parent_group_id }},
        {% endif %}
        "id_attribute": {{ attribute_mapping(perun.id_attribute) }},
        "managers_group_attribute": {{ attribute_mapping(perun.managers_group_attribute) }},
        "properties_mapping": {
            {% for property, mappings in perun.properties_mapping.items() %}
            "{{ property }}": [
                {% for mapping in mappings %}
                {{ attribute_mapping(mapping) }}{% if not loop.last %},{% endif %}
                {% endfor %}
            ]{% if not loop.last %},{% endif %}
            {% endfor %}
        },
        "static_attributes": [
            {% for attr in perun.static_attributes %}
            {
                "id": {{ attr.id }},
                "type": "{{ attr.type }}",
                "attribute": "{{ attr.attribute }}",
                "value": "{{ attr.value }}"
            }{% if not loop.last %},{% endif %}
            {% endfor %}
        ]
    }
{% endmacro %}
{
{% if fedreg_agent_enable_keycloak | bool == True %}
    "keycloak": {
        {{ ams_config(fedreg_agent_keycloak) }},
        "auth_server": "{{ fedreg_agent_keycloak.auth_server }}",
        "realm": "{{ fedreg_agent_keycloak.realm }}",
{% if fedreg_agent_keycloak.refresh_token is defined %}
        "refresh_token": "{{ fedreg_agent_keycloak.refresh_token }}",
{% endif %}
        "client_id": "{{ fedreg_agent_keycloak.client_id }}",
        "client_secret": "{{ fedreg_agent_keycloak.client_secret }}",
{% if fedreg_agent_keycloak.oidc_consent is defined %}
        "oidc_consent": {{ fedreg_agent_keycloak.oidc_consent | bool | to_json }},
{% endif %}
{% if fedreg_agent_keycloak.saml_consent is defined %}
        "saml_consent": {{ fedreg_agent_keycloak.saml_consent | bool | to_json }},
{% endif %}
        "service_account": {
            "attribute_name": "{{ fedreg_agent_keycloak.service_account.attribute_name }}",
            "candidate": "{{ fedreg_agent_keycloak.service_account.candidate }}",
            "scope": "{{ fedreg_agent_keycloak.service_account.scope }}"
        },
        {% if fedreg_agent_keycloak.perun is defined %}
            {{ perun_config(fedreg_agent_keycloak.perun) }}
        {% endif %}
    },
{% endif %}
{% if fedreg_agent_enable_mitreid | bool == True %}
    "mitreid": {
        {{ ams_config(fedreg_agent_mitreid) }},
        "issuer": "{{ fedreg_agent_mitreid.url }}",
        "refresh_token": "{{ fedreg_agent_mitreid.refresh_token }}",
        "client_id": "{{ fedreg_agent_mitreid.client_id }}",
        "client_secret": "{{ fedreg_agent_mitreid.client_secret }}",
        {% if fedreg_agent_mitreid.perun is defined %}
            {{ perun_config(fedreg_agent_mitreid.perun) }}
        {% endif %}
    },
{% endif %}
{% if fedreg_agent_enable_ssp | bool == True %}
    "ssp": {
        {{ ams_config(fedreg_agent_ssp) }},
        "metadata_conf_file": "{{ fedreg_agent_ssp.metadata_file }}",
        "cron_secret": "{{ fedreg_agent_ssp.metadata_key }}",
        "cron_url": "{{ fedreg_agent_ssp.url }}",
        "cron_tag": "hourly",
        "request_timeout": {{ fedreg_agent_ssp.request_timeout }},
        {% if fedreg_agent_ssp.perun is defined %}
            {{ perun_config(fedreg_agent_ssp.perun) }}
        {% endif %}
    },
{% endif %}
{% if fedreg_agent_enable_cas | bool == True %}
    "cas": {
        {{ ams_config(fedreg_agent_cas) }},
        {{ rabbitmq_config(fedreg_agent_cas) }},
        "cas_url": "{{ fedreg_agent_cas.cas_url }}",
        "username": "{{ fedreg_agent_cas.username }}",
        "password": "{{ fedreg_agent_cas.password }}",
        {% if fedreg_agent_cas.perun is defined %}
            {{ perun_config(fedreg_agent_cas.perun) }}
        {% endif %}
    },
{% endif %}
    "log_conf": "{{ fedreg_agent_log_conf }}"
}
